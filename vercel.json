{
  "framework": "vite",
  "build": {
    "env": {
      "UV_NO_CACHE": "1",
      "PIP_NO_CACHE_DIR": "1"
    }
  },
  "buildCommand": "cd frontend && npm install && npm run build && rm -rf node_modules",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "frontend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
