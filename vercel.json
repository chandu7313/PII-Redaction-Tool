{
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build && rm -rf node_modules",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://pii-redaction-tool-uwcj.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
